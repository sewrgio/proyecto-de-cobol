       IDENTIFICATION DIVISION.
       PROGRAM-ID. PROC-FACTURA-JSON.
       
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ARCHIVO-ENTRADA ASSIGN TO "factura-input.json"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-STATUS-IN.
           SELECT ARCHIVO-SALIDA  ASSIGN TO "factura-output.json"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-STATUS-OUT.
       
       DATA DIVISION.
       FILE SECTION.
       FD  ARCHIVO-ENTRADA.
       01  REG-ENTRADA           PIC X(300).
       FD  ARCHIVO-SALIDA.
       01  REG-SALIDA            PIC X(300).
       
       WORKING-STORAGE SECTION.
       COPY "FAC-ENCABEZADO.cpy".
       COPY "FAC-RENGLON.cpy".
       COPY "FISCAL-SENIAT.cpy".
       COPY "EMPRESA.cpy".
       COPY "CAJERO.cpy".
       COPY "PAGO.cpy".
       
       01  WS-STATUS-IN          PIC X(02).
       01  WS-STATUS-OUT         PIC X(02).
       01  WS-FIN-ARCHIVO        PIC X VALUE "N".
           88 FIN-ARCHIVO        VALUE "S".
       01  WS-CONTADOR-ITEMS     PIC 9(03) VALUE 0.
       01  WS-RESPUESTA          PIC 9(02) VALUE 0.
       01  WS-LINEA-TRIM         PIC X(300).
       01  WS-VALOR              PIC X(100).
       01  WS-VALOR-NUM          PIC 9(09)V99.
       01  WS-VALOR-ENT          PIC 9(05).
       01  WS-POS-CLAVE          PIC 9(03).
       01  WS-POS-COM1          PIC 9(03).
       01  WS-POS-COM2          PIC 9(03).
       01  WS-POS-TMP            PIC 9(03).
       01  WS-LARGO-VALOR        PIC 9(03).
       01  WS-MONTO-TXT          PIC Z(07)9.99.
       01  WS-ENTERO-TXT         PIC Z(08)9.
       01  WS-ITEM-ACTUAL        PIC 9(03) VALUE 0.
       
       PROCEDURE DIVISION.
       0000-MAIN.
           PERFORM 1000-INICIALIZAR
           PERFORM 2000-LEER-ENTRADA
           DISPLAY "═══════════════════════════════════════"
           DISPLAY " ESTADO ANTES DE PROCESAR:"
           DISPLAY "   FAC-COD-CLIENTE: [" FAC-COD-CLIENTE "]"
           DISPLAY "   FIS-RIF-CLIENTE: [" FIS-RIF-CLIENTE "]"
           DISPLAY "   FIS-RAZON-SOCIAL: [" FIS-RAZON-SOCIAL "]"
           DISPLAY "   FAC-FORMA-PAGO: [" FAC-FORMA-PAGO "]"
           DISPLAY "   FAC-CANT-ITEMS: " FAC-CANT-ITEMS
           DISPLAY "   ITEM 1 COD: [" REN-COD-PROD(1) "]"
           DISPLAY "   ITEM 1 CANT: " REN-CANTIDAD(1)
           DISPLAY "   ITEM 1 PRECIO: " REN-PRECIO-UNIT(1)
           DISPLAY "   ITEM 1 ALIC: [" REN-ALICUOTA(1) "]"
           PERFORM 3000-PROCESAR-FACTURA
           PERFORM 4000-ESCRIBIR-SALIDA
           STOP RUN.
       
       1000-INICIALIZAR.
           INITIALIZE FACTURA-CABECERA
           INITIALIZE FAC-DETALLE
           INITIALIZE DATOS-FISCALES-SENIAT
           INITIALIZE EMPRESA-SUCURSAL
           INITIALIZE CAJERO-INFO
           INITIALIZE DATOS-PAGO
           MOVE 0 TO WS-CONTADOR-ITEMS WS-ITEM-ACTUAL
           MOVE "N" TO WS-FIN-ARCHIVO.
       
       2000-LEER-ENTRADA.
           OPEN INPUT ARCHIVO-ENTRADA
           PERFORM UNTIL FIN-ARCHIVO
               READ ARCHIVO-ENTRADA
                   AT END MOVE "S" TO WS-FIN-ARCHIVO
                   NOT AT END
                       MOVE REG-ENTRADA TO WS-LINEA-TRIM
                       PERFORM 2100-PARSEAR-LINEA
               END-READ
           END-PERFORM
           CLOSE ARCHIVO-ENTRADA.
       
       2100-PARSEAR-LINEA.
           *> ---- rifCliente ----
           MOVE "rifCliente" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               MOVE WS-VALOR(1:12) TO FIS-RIF-CLIENTE
               MOVE WS-VALOR(1:10) TO FAC-COD-CLIENTE
               DISPLAY "   ✓ RIF Cliente: [" WS-VALOR(1:12) "]"
           END-IF
           
           *> ---- razonSocial ----
           MOVE "razonSocial" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               MOVE WS-VALOR(1:40) TO FIS-RAZON-SOCIAL
               DISPLAY "   ✓ Razon Social: [" WS-VALOR(1:40) "]"
           END-IF
           
           *> ---- formaPago ----
           MOVE "formaPago" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               MOVE WS-VALOR(1:2) TO FAC-FORMA-PAGO
               DISPLAY "   ✓ Forma Pago: [" WS-VALOR(1:2) "]"
           END-IF
           
           *> ---- fechaEmision ----
           MOVE "fechaEmision" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               MOVE FUNCTION NUMVAL(WS-VALOR) TO FAC-FECHA-EMISION
           END-IF
           
           *> ---- horaEmision ----
           MOVE "horaEmision" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               MOVE FUNCTION NUMVAL(WS-VALOR) TO FAC-HORA-EMISION
           END-IF
           
           *> ---- montoPagado ----
           MOVE "montoPagado" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               COMPUTE PAG-MONTO-PAGADO = FUNCTION NUMVAL(WS-VALOR)
           END-IF
           
           *> ---- codigoItem (contador) ----
           MOVE "codigoItem" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0
               ADD 1 TO WS-CONTADOR-ITEMS
               MOVE WS-CONTADOR-ITEMS TO WS-ITEM-ACTUAL
               MOVE WS-VALOR(1:10) TO REN-COD-PROD(WS-ITEM-ACTUAL)
               DISPLAY "   ✓ Item " WS-ITEM-ACTUAL " cod: [" WS-VALOR(1:10) "]"
           END-IF
           
           *> ---- nombreItem ----
           MOVE "nombreItem" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0 AND WS-ITEM-ACTUAL <= 10
               MOVE WS-VALOR(1:40) TO REN-NOMBRE-PROD(WS-ITEM-ACTUAL)
           END-IF
           
           *> ---- cantidadItem ----
           MOVE "cantidadItem" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0 AND WS-ITEM-ACTUAL <= 10
               COMPUTE WS-VALOR-ENT = FUNCTION NUMVAL(WS-VALOR)
               MOVE WS-VALOR-ENT TO REN-CANTIDAD(WS-ITEM-ACTUAL)
           END-IF
           
           *> ---- precioItem ----
           MOVE "precioItem" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0 AND WS-ITEM-ACTUAL <= 10
               COMPUTE WS-VALOR-NUM = FUNCTION NUMVAL(WS-VALOR)
               MOVE WS-VALOR-NUM TO REN-PRECIO-UNIT(WS-ITEM-ACTUAL)
           END-IF
           
           *> ---- alicuotaItem ----
           MOVE "alicuotaItem" TO WS-VALOR
           PERFORM 8100-BUSCAR-Y-EXTRAER
           IF WS-POS-CLAVE > 0 AND WS-ITEM-ACTUAL <= 10
               MOVE WS-VALOR(1:1) TO REN-ALICUOTA(WS-ITEM-ACTUAL)
           END-IF.
       
       *> Busca la clave WS-VALOR en WS-LINEA-TRIM y extrae el valor
       *> Devuelve el valor en WS-VALOR y la posición de la clave en WS-POS-CLAVE
       *> WS-POS-CLAVE = 0 si no se encuentra
       8100-BUSCAR-Y-EXTRAER.
           MOVE 0 TO WS-POS-CLAVE
           MOVE 0 TO WS-POS-COM1
           MOVE 0 TO WS-POS-COM2
           MOVE 0 TO WS-POS-TMP
           MOVE 0 TO WS-LARGO-VALOR
           
           *> 1. Calcular el largo REAL de la clave
           COMPUTE WS-LARGO-VALOR = 
               FUNCTION LENGTH(FUNCTION TRIM(WS-VALOR))
           
           *> 2. Buscar la posición de la clave
           INSPECT WS-LINEA-TRIM TALLYING WS-POS-TMP
               FOR CHARACTERS BEFORE INITIAL WS-VALOR
           
           *> Si la clave no está, salir
           IF WS-POS-TMP >= 290
               EXIT PARAGRAPH
           END-IF
           
           *> Guardar la posición de la clave
           MOVE WS-POS-TMP TO WS-POS-CLAVE
           
           *> 3. Avanzar después de la clave (saltar la clave + ": ")
           *>    Posición de la clave + largo de clave + 3 (por '": ')
           COMPUTE WS-POS-TMP = 
               WS-POS-CLAVE + WS-LARGO-VALOR + 3
           
           *> 4. Buscar la PRIMERA comilla de apertura del valor
           MOVE 0 TO WS-POS-COM1
           INSPECT WS-LINEA-TRIM(WS-POS-TMP:200) TALLYING WS-POS-COM1
               FOR CHARACTERS BEFORE INITIAL '"'
           
           *> Si no encuentra comilla, salir
           IF WS-POS-COM1 >= 200
               MOVE 0 TO WS-POS-CLAVE
               EXIT PARAGRAPH
           END-IF
           
           *> 5. Calcular la posición real después de la comilla de apertura
           COMPUTE WS-POS-TMP = WS-POS-TMP + WS-POS-COM1 + 1
           
           *> 6. Buscar la SEGUNDA comilla (que cierra el valor)
           MOVE 0 TO WS-POS-COM2
           INSPECT WS-LINEA-TRIM(WS-POS-TMP:200) TALLYING WS-POS-COM2
               FOR CHARACTERS BEFORE INITIAL '"'
           
           IF WS-POS-COM2 = 0
               MOVE 0 TO WS-POS-CLAVE
               EXIT PARAGRAPH
           END-IF
           
           *> 7. Extraer el valor entre las dos comillas
           MOVE SPACES TO WS-VALOR
           MOVE WS-LINEA-TRIM(WS-POS-TMP:WS-POS-COM2) TO WS-VALOR.
       
       3000-PROCESAR-FACTURA.
           MOVE WS-CONTADOR-ITEMS TO FAC-CANT-ITEMS
           CALL "PROC-FACTURA" USING FACTURA-CABECERA
                                    FAC-DETALLE
                                    DATOS-FISCALES-SENIAT
                                    WS-RESPUESTA.
       
       4000-ESCRIBIR-SALIDA.
           OPEN OUTPUT ARCHIVO-SALIDA
           MOVE "{" TO REG-SALIDA
           WRITE REG-SALIDA
           IF WS-RESPUESTA = 0
               MOVE '  "estado": "OK",' TO REG-SALIDA
               WRITE REG-SALIDA
               MOVE '  "codigoError": 0,' TO REG-SALIDA
               WRITE REG-SALIDA
               STRING '  "numeroControl": "' DELIMITED BY SIZE
                      FIS-NUM-CONTROL DELIMITED BY SIZE
                      '",' DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
               MOVE FAC-NUMERO TO WS-ENTERO-TXT
               STRING '  "numeroFactura": ' DELIMITED BY SIZE
                      WS-ENTERO-TXT DELIMITED BY SIZE
                      ',' DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
               MOVE FIS-BASE-IMP-GEN TO WS-MONTO-TXT
               STRING '  "baseImponible": ' DELIMITED BY SIZE
                      WS-MONTO-TXT DELIMITED BY SIZE
                      ',' DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
               MOVE FIS-BASE-EXENTO TO WS-MONTO-TXT
               STRING '  "baseExento": ' DELIMITED BY SIZE
                      WS-MONTO-TXT DELIMITED BY SIZE
                      ',' DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
               MOVE FIS-MONTO-IVA-GEN TO WS-MONTO-TXT
               STRING '  "iva": ' DELIMITED BY SIZE
                      WS-MONTO-TXT DELIMITED BY SIZE
                      ',' DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
               MOVE FIS-MONTO-IGTF TO WS-MONTO-TXT
               STRING '  "igtf": ' DELIMITED BY SIZE
                      WS-MONTO-TXT DELIMITED BY SIZE
                      ',' DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
               MOVE FAC-TOTAL-NETO TO WS-MONTO-TXT
               STRING '  "total": ' DELIMITED BY SIZE
                      WS-MONTO-TXT DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
           ELSE
               MOVE '  "estado": "ERROR",' TO REG-SALIDA
               WRITE REG-SALIDA
               MOVE WS-RESPUESTA TO WS-ENTERO-TXT
               STRING '  "codigoError": ' DELIMITED BY SIZE
                      WS-ENTERO-TXT DELIMITED BY SIZE
                      INTO REG-SALIDA
               END-STRING
               WRITE REG-SALIDA
           END-IF
           MOVE "}" TO REG-SALIDA
           WRITE REG-SALIDA
           CLOSE ARCHIVO-SALIDA.

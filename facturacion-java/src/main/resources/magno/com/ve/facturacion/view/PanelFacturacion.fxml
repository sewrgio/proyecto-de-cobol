<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="magno.com.ve.facturacion.ui.controller.PanelFacturacionController"
            styleClass="pos-root"
            stylesheets="@../css/magno.css">

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <top>
        <HBox styleClass="pos-header" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="2">
                <Label text="🏢 TIENDA NOVA" styleClass="pos-brand-name"/>
                <Label text="Estilo · Calidad · Confianza" styleClass="pos-brand-tag"/>
            </VBox>

            <Separator orientation="VERTICAL" styleClass="pos-vsep"/>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblCajero"
                       text="Cajero: Ana Martínez"
                       styleClass="pos-header-cajero"/>
                <Label text="● Activo" styleClass="pos-header-status"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblTasa"
                   text="Tasa: consultando..."
                   styleClass="pos-header-fecha"
                   style="-fx-font-size: 12px;"/>

            <Separator orientation="VERTICAL" styleClass="pos-vsep"/>

            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="lblHora" styleClass="pos-header-hora"/>
                <Label fx:id="lblFecha" styleClass="pos-header-fecha"/>
            </VBox>

            <Separator orientation="VERTICAL" styleClass="pos-vsep"/>

            <Button text="Cerrar Turno"
                    styleClass="pos-btn-danger-sm"
                    onAction="#handleCerrarSesion"/>
        </HBox>
    </top>

    <!-- ============================================================
         CONTENIDO PRINCIPAL
         ============================================================ -->
    <center>
        <HBox spacing="16" styleClass="pos-content">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <!-- COLUMNA 1 — Carrito -->
            <VBox styleClass="pos-card" spacing="12" prefWidth="320" minWidth="300">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Productos añadidos" styleClass="pos-card-title"/>
                    <Label fx:id="lblItemsCount" text="(0)" styleClass="pos-items-count"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Editar lista" styleClass="pos-btn-link"/>
                </HBox>

                <ListView fx:id="lstCarrito"
                          VBox.vgrow="ALWAYS"
                          styleClass="pos-lista-carrito"/>

                <Button text="＋  Agregar producto"
                        styleClass="pos-btn-agregar"
                        maxWidth="Infinity"
                        onAction="#handleAgregarProducto"/>
            </VBox>

            <!-- COLUMNA 2 — Totales -->
            <VBox styleClass="pos-card pos-card-total" spacing="14" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="24" bottom="20" left="24"/>
                </padding>

                <Label text="TOTAL A PAGAR"
                       styleClass="pos-total-titulo"
                       maxWidth="Infinity"
                       alignment="CENTER"/>

                <Label fx:id="lblTotalGrande"
                       styleClass="pos-total-grande"
                       maxWidth="Infinity"
                       alignment="CENTER"/>

                <Label fx:id="lblTotalBsGrande"
                       text=""
                       maxWidth="Infinity"
                       alignment="CENTER"
                       style="-fx-font-size: 18px; -fx-text-fill: #28a745;"/>

                <Separator styleClass="pos-separator"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Subtotal" styleClass="pos-total-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="lblSubtotal" styleClass="pos-total-value"/>
                        <Label fx:id="lblSubtotalBs"
                               style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Impuestos (16%)" styleClass="pos-total-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="lblMontoIva" styleClass="pos-total-value"/>
                        <Label fx:id="lblMontoIvaBs"
                               style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Descuentos" styleClass="pos-total-label pos-total-descuento"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="lblDescuento" styleClass="pos-total-value pos-total-descuento"/>
                        <Label fx:id="lblDescuentoBs"
                               style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    </VBox>
                </HBox>

                <Separator styleClass="pos-separator"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Total" styleClass="pos-total-final-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="lblTotalUsd" styleClass="pos-total-final-value"/>
                        <Label fx:id="lblTotalBs"
                               style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    </VBox>
                </HBox>

                <HBox styleClass="pos-aviso-listo" alignment="CENTER_LEFT" spacing="10">
                    <Label text="✓" styleClass="pos-aviso-icon"/>
                    <VBox spacing="1">
                        <Label text="Listo para cobrar" styleClass="pos-aviso-titulo"/>
                        <Label text="Selecciona un método de pago para continuar"
                               styleClass="pos-aviso-sub"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="●" styleClass="pos-aviso-dot"/>
                </HBox>
            </VBox>

            <!-- COLUMNA 3 — Métodos de pago -->
            <VBox spacing="12" prefWidth="280" minWidth="260">

                <Button styleClass="pos-metodo-pago" maxWidth="Infinity"
                        onAction="#handleCobroEfectivo">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="💵" styleClass="pos-metodo-icon"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label text="Efectivo" styleClass="pos-metodo-titulo"/>
                                <Label text="Pago en caja" styleClass="pos-metodo-sub"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="pos-metodo-pago" maxWidth="Infinity"
                        onAction="#handleCobroDebito">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="💳" styleClass="pos-metodo-icon"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label text="Tarjeta Débito/Crédito" styleClass="pos-metodo-titulo"/>
                                <Label text="Visa · Mastercard · Amex" styleClass="pos-metodo-sub"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="pos-metodo-pago" maxWidth="Infinity"
                        onAction="#handleCobroQR">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="🔳" styleClass="pos-metodo-icon"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label text="QR / Transferencia" styleClass="pos-metodo-titulo"/>
                                <Label text="Escanea o envía link de pago" styleClass="pos-metodo-sub"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button text="⇅  Ver más métodos"
                        styleClass="pos-btn-secundario"
                        maxWidth="Infinity"
                        onAction="#handleVerMasMetodos"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="✅  PROCESAR PAGO  [Ctrl+G]"
                        styleClass="pos-btn-facturar-xl"
                        maxWidth="Infinity"
                        prefHeight="56"
                        onAction="#handleCobrarFacturar"/>
            </VBox>
        </HBox>
    </center>

    <!-- ============================================================
         FOOTER
         ============================================================ -->
    <bottom>
        <HBox styleClass="pos-footer" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <Button styleClass="pos-accion-rapida" onAction="#handleNuevaVenta">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="＋" styleClass="pos-accion-icon"/>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label text="Nueva venta" styleClass="pos-accion-titulo"/>
                            <Label text="Iniciar nueva venta" styleClass="pos-accion-sub"/>
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <Button styleClass="pos-accion-rapida" onAction="#handleCancelarVenta">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="✖" styleClass="pos-accion-icon pos-accion-icon-danger"/>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label text="Cancelar" styleClass="pos-accion-titulo"/>
                            <Label text="Cancelar venta" styleClass="pos-accion-sub"/>
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <Button styleClass="pos-accion-rapida" onAction="#handleAbrirCaja">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🗄" styleClass="pos-accion-icon"/>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label text="Abrir cajón" styleClass="pos-accion-titulo"/>
                            <Label text="Abrir caja registradora" styleClass="pos-accion-sub"/>
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- ⬅ CAMBIADO: "Imprimir ticket" → "Nota de crédito" -->
            <Button styleClass="pos-accion-rapida" onAction="#handleNotaCredito">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🧾" styleClass="pos-accion-icon"/>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label text="Nota de crédito" styleClass="pos-accion-titulo"/>
                            <Label text="Emitir / reimprimir NC" styleClass="pos-accion-sub"/>
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnMasOpciones"
                    styleClass="pos-accion-rapida" 
                    onAction="#handleMasOpciones">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="•••" styleClass="pos-accion-icon"/>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label text="Más opciones" styleClass="pos-accion-titulo"/>
                            <Label text="Herramientas y ajustes" styleClass="pos-accion-sub"/>
                        </VBox>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
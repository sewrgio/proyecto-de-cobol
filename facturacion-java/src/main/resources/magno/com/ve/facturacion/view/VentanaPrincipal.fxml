<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="magno.com.ve.facturacion.ui.controller.PanelAdminController"
            styleClass="admin-root"
            stylesheets="@../css/magno.css">

    <!-- ==== SIDEBAR IZQUIERDO ==== -->
    <left>
        <VBox styleClass="admin-sidebar" prefWidth="240" minWidth="220" spacing="4">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12"/>
            </padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-logo-box">
                <Label text="M" styleClass="admin-logo-icon"/>
                <VBox spacing="0">
                    <Label text="MAGNO" styleClass="admin-logo-name"/>
                    <Label text="A D M I N" styleClass="admin-logo-tag"/>
                </VBox>
            </HBox>

            <Region prefHeight="18"/>

            <!-- Navegación -->
            <Button text="🏠   Dashboard"
                    styleClass="admin-nav-btn admin-nav-active"
                    maxWidth="Infinity"
                    onAction="#handleNavDashboard"/>
            <Button text="👥   Usuarios"
                    styleClass="admin-nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenuUsuarios"/>
            <Button text="📦   Productos"
                    styleClass="admin-nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenuProductos"/>
            <Button text="📊   Reportes"
                    styleClass="admin-nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenuReportes"/>
            <Button text="⚙️   Configuración"
                    styleClass="admin-nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenuFiscal"/>
            <Button text="🗄️   Cajas"
                    styleClass="admin-nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenuCajas"/>
            <Button text="📥   Inventario"
                    styleClass="admin-nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenuInventario"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Estado del sistema -->
            <HBox styleClass="admin-status-box" alignment="CENTER_LEFT" spacing="10">
                <Label text="●" styleClass="admin-status-dot"/>
                <VBox spacing="0">
                    <Label text="Sistema POS" styleClass="admin-status-title"/>
                    <Label text="Todo en orden" styleClass="admin-status-sub"/>
                </VBox>
            </HBox>

            <Button text="🚪   Cerrar Sesión"
                    styleClass="pos-btn-danger"
                    maxWidth="Infinity"
                    onAction="#handleCerrarSesion"/>
        </VBox>
    </left>

    <!-- ==== CONTENIDO PRINCIPAL ==== -->
    <center>
        <VBox spacing="0">

            <!-- == HEADER == -->
            <HBox styleClass="admin-header" alignment="CENTER_LEFT" spacing="16">
                <padding>
                    <Insets top="14" right="24" bottom="14" left="24"/>
                </padding>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👤" styleClass="admin-avatar"/>
                    <VBox spacing="0">
                        <Label fx:id="lblNombreUsuario"
                               text="Carlos Mendoza"
                               styleClass="admin-user-name"/>
                        <Label fx:id="lblRolUsuario"
                               text="✔ Administrador"
                               styleClass="admin-user-role"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL" styleClass="admin-vsep"/>

                <VBox alignment="CENTER_RIGHT" spacing="0">
                    <Label fx:id="lblFecha" text="21 de mayo de 2025" styleClass="admin-fecha"/>
                    <Label fx:id="lblHora"  text="🕐 10:24 AM"          styleClass="admin-hora"/>
                </VBox>

                <Label text="⌄" styleClass="admin-chevron"/>
            </HBox>

            <!-- == SCROLL == -->
            <ScrollPane fitToWidth="true" styleClass="admin-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="16">
                    <padding>
                        <Insets top="20" right="24" bottom="24" left="24"/>
                    </padding>

                    <!-- Título + acciones rápidas -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="2">
                            <Label text="Dashboard" styleClass="admin-page-title"/>
                            <Label text="Resumen general del sistema POS MAGNO" styleClass="admin-page-sub"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox styleClass="admin-acciones-rapidas" spacing="6">
                            <Label text="Acciones rápidas" styleClass="admin-ar-title"/>
                            <HBox spacing="8">
                                <Button text="👤  Nuevo usuario"   styleClass="admin-btn-acceso" onAction="#handleNuevoUsuario"/>
                                <Button text="📦  Nuevo producto"  styleClass="admin-btn-acceso" onAction="#handleNuevoProducto"/>
                                <Button text="📄  Generar reporte" styleClass="admin-btn-acceso" onAction="#handleGenerarReporte"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- == KPI CARDS == -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        </columnConstraints>

                        <VBox styleClass="admin-kpi-card" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="💲" styleClass="admin-kpi-icon admin-kpi-icon-green"/>
                                <Label text="Ventas del día" styleClass="admin-kpi-title"/>
                            </HBox>
                            <Label fx:id="lblVentasDia" text="4,250.75" styleClass="admin-kpi-value"/>
                            <Label text="↑ 12.5% vs ayer" styleClass="admin-kpi-delta admin-delta-up"/>
                        </VBox>

                        <VBox styleClass="admin-kpi-card" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🧾" styleClass="admin-kpi-icon admin-kpi-icon-blue"/>
                                <Label text="Ticket promedio" styleClass="admin-kpi-title"/>
                            </HBox>
                            <Label fx:id="lblTicketProm" text="156.80" styleClass="admin-kpi-value"/>
                            <Label text="↑ 8.3% vs ayer" styleClass="admin-kpi-delta admin-delta-up"/>
                        </VBox>

                        <VBox styleClass="admin-kpi-card" spacing="8"
                              GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="📦" styleClass="admin-kpi-icon admin-kpi-icon-teal"/>
                                <Label text="Productos vendidos" styleClass="admin-kpi-title"/>
                            </HBox>
                            <Label fx:id="lblProdVendidos" text="286" styleClass="admin-kpi-value"/>
                            <Label text="↑ 15.7% vs ayer" styleClass="admin-kpi-delta admin-delta-up"/>
                        </VBox>

                        <VBox styleClass="admin-kpi-card" spacing="8"
                              GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="👥" styleClass="admin-kpi-icon admin-kpi-icon-blue"/>
                                <Label text="Usuarios activos" styleClass="admin-kpi-title"/>
                            </HBox>
                            <Label fx:id="lblUsuariosAct" text="128" styleClass="admin-kpi-value"/>
                            <Label text="↑ 6.2% vs ayer" styleClass="admin-kpi-delta admin-delta-up"/>
                        </VBox>
                    </GridPane>

                    <!-- == GRÁFICO == -->
                    <VBox styleClass="admin-card" spacing="12">
                        <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Ventas de la semana" styleClass="admin-card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="cmbRango" styleClass="admin-combo"/>
                            <VBox alignment="CENTER_RIGHT" spacing="0">
                                <Label text="21 may" styleClass="admin-chart-day"/>
                                <Label text="4,250.75" styleClass="admin-chart-val"/>
                            </VBox>
                        </HBox>

                        <LineChart fx:id="chartVentas" prefHeight="240"
                                   styleClass="admin-chart"
                                   createSymbols="true"
                                   legendVisible="false"
                                   animated="false">
                            <xAxis>
                                <CategoryAxis fx:id="xAxisChart"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxisChart"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- == TABLA MOVIMIENTOS == -->
                    <VBox styleClass="admin-card" spacing="12">
                        <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Últimos movimientos" styleClass="admin-card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Ver todos  →" styleClass="admin-btn-link"
                                    onAction="#handleVerTodos"/>
                        </HBox>

                        <TableView fx:id="tblMovimientos" prefHeight="240" styleClass="admin-table">
                            <columns>
                                <TableColumn fx:id="colId"      text="ID"            prefWidth="140"/>
                                <TableColumn fx:id="colFecha"   text="Fecha y hora"  prefWidth="160"/>
                                <TableColumn fx:id="colTipo"    text="Tipo"          prefWidth="110"/>
                                <TableColumn fx:id="colDesc"    text="Descripción"   prefWidth="240"/>
                                <TableColumn fx:id="colUsuario" text="Usuario"       prefWidth="140"/>
                                <TableColumn fx:id="colTotal"   text="Total"         prefWidth="110"/>
                                <TableColumn fx:id="colEstado"  text="Estado"        prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="magno.com.ve.facturacion.ui.controller.LoginController"
           styleClass="login-root"
           stylesheets="@../css/magno.css">

    <!-- Tarjeta central -->
    <VBox alignment="CENTER" maxWidth="380" maxHeight="520" styleClass="login-card" spacing="18">
        <padding>
            <Insets top="40" right="40" bottom="35" left="40"/>
        </padding>

        <!-- Icono de usuario -->
        <StackPane alignment="CENTER" styleClass="login-avatar-container">
            <Circle radius="38" styleClass="login-avatar-circle"/>
            <FontIcon iconLiteral="mdi2a-account" iconSize="42" styleClass="login-avatar-icon"/>
        </StackPane>

        <!-- Título -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="MAGNO" styleClass="login-title"/>
            <Label text="Iniciar Sesión" styleClass="login-subtitle"/>
        </VBox>

        <!-- Formulario -->
        <VBox spacing="14" VBox.vgrow="ALWAYS">
            <VBox spacing="6">
                <Label text="Usuario" styleClass="login-field-label"/>
                <TextField fx:id="txtUsuario"
                           promptText="Ingrese su usuario"
                           styleClass="login-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Contraseña" styleClass="login-field-label"/>
                <PasswordField fx:id="txtPassword"
                               promptText="••••••••"
                               styleClass="login-input"/>
            </VBox>

            <Label fx:id="lblError"
                   text=""
                   styleClass="login-error-label"
                   maxWidth="Infinity"
                   wrapText="true"/>
        </VBox>

        <!-- Botón principal -->
        <Button text="INICIAR SESIÓN"
                styleClass="login-btn-primary"
                maxWidth="Infinity"
                onAction="#handleLogin"
                defaultButton="true"/>

        <!-- Botón secundario -->
        <Button text="Salir"
                styleClass="login-btn-secondary"
                maxWidth="Infinity"
                onAction="#handleCancelar"
                cancelButton="true"/>

        <Label text="v1.0.0  •  Módulo de Seguridad"
               styleClass="login-version"
               alignment="CENTER"
               maxWidth="Infinity"/>
    </VBox>
</StackPane>
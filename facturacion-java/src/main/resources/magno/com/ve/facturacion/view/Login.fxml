<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="magno.com.ve.facturacion.ui.controller.LoginController"
           styleClass="login-root"
           prefWidth="500" prefHeight="620">

    <VBox alignment="CENTER" spacing="0" styleClass="login-card" maxWidth="420" maxHeight="540">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="MAGNO" styleClass="login-logo"/>
        <Label text="Suite de Gestión Empresarial" styleClass="login-subtitle"/>
        <Label text="Todos los procesos de tu empresa, en un solo lugar." styleClass="login-description"/>

        <Region prefHeight="40"/>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Usuario" styleClass="field-label"/>
            <TextField fx:id="txtUsuario"
                       promptText="Ingrese su usuario"
                       styleClass="text-field"/>
        </VBox>

        <Region prefHeight="15"/>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtPassword"
                           promptText="Ingrese su contraseña"
                           styleClass="text-field"/>
        </VBox>

        <Region prefHeight="10"/>

        <Label fx:id="lblMensaje" text="" styleClass="error-label" wrapText="true"/>

        <Region prefHeight="25"/>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Ingresar" onAction="#handleLogin"
                    styleClass="btn-primary" defaultButton="true"
                    prefWidth="160" prefHeight="42"/>
            <Button text="Cancelar" onAction="#handleCancelar"
                    styleClass="btn-secondary"
                    prefWidth="120" prefHeight="42"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="v1.0.0" styleClass="version-label"/>
    </VBox>
</StackPane>

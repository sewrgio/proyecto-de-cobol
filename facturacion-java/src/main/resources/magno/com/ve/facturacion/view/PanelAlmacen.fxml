<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="magno.com.ve.facturacion.ui.controller.PanelAlmacenController"
            styleClass="panel-root">

    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->
    <top>
        <VBox styleClass="panel-header">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <Label text="Registrar Nuevo Producto" styleClass="section-title"/>
            <Label text="Complete los datos del producto para agregarlo al almacén"
                   styleClass="section-subtitle"/>
        </VBox>
    </top>

    <!-- ============================================================
         CENTRO: FORMULARIO (scrollable)
         ============================================================ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <VBox spacing="16">

                <!-- ══════════════════════════════════════════════
                     TARJETA 1: IDENTIFICACIÓN DEL PRODUCTO
                     ══════════════════════════════════════════════ -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Identificación del Producto" styleClass="card-title"/>

                    <!-- Fila 1: Nº de barra | Nombre del producto -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nº de barra *" styleClass="field-label"/>
                            <TextField fx:id="txtNumeroBarra"
                                       promptText="Ej: 7591234567890"
                                       styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nombre del producto *" styleClass="field-label"/>
                            <TextField fx:id="txtNombreProducto"
                                       promptText="Ej: Harina P.A.N. 1kg"
                                       styleClass="text-field"/>
                        </VBox>
                    </HBox>

                    <!-- Fila 2: Tipo producto | Marca -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Tipo de producto *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbTipoProducto"
                                      styleClass="combo-box"
                                      maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Marca del producto" styleClass="field-label"/>
                            <TextField fx:id="txtMarcaProducto"
                                       promptText="Ej: P.A.N."
                                       styleClass="text-field"/>
                        </VBox>
                    </HBox>

                    <!-- Fila 3: Unidad de medida | Cantidad | Descripción -->
                    <HBox spacing="20">
                        <VBox spacing="6" prefWidth="200">
                            <Label text="Unidad de medida *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbUnidadMedida"
                                      styleClass="combo-box"
                                      maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="150">
                            <Label text="Cantidad *" styleClass="field-label"/>
                            <TextField fx:id="txtCantidad"
                                       promptText="Ej: 12"
                                       styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Descripción" styleClass="field-label"/>
                            <TextField fx:id="txtDescripcion"
                                       promptText="Descripción opcional"
                                       styleClass="text-field"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ══════════════════════════════════════════════
                     TARJETA 2: FÁBRICA
                     ══════════════════════════════════════════════ -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Fábrica" styleClass="card-title"/>

                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Compañía *" styleClass="field-label"/>
                            <TextField fx:id="txtCompania"
                                       promptText="Ej: Alimentos Polar"
                                       styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="País *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbPais"
                                      styleClass="combo-box"
                                      maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="RIF / Identificación *" styleClass="field-label"/>
                        <TextField fx:id="txtRif"
                                   promptText="Ej: J-12345678-9"
                                   styleClass="text-field"/>
                    </VBox>
                </VBox>

                <!-- ══════════════════════════════════════════════
                     TARJETA 3: MEDIDAS
                     ══════════════════════════════════════════════ -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Medidas" styleClass="card-title"/>

                    <!-- Fila 1: Tipo de medida | Cantidad | Contenido -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Tipo de medida *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbTipoMedida"
                                      styleClass="combo-box"
                                      maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Cantidad *" styleClass="field-label"/>
                            <TextField fx:id="txtCantidadMedida"
                                       promptText="Ej: 1"
                                       styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Contenido *" styleClass="field-label"/>
                            <TextField fx:id="txtContenido"
                                       promptText="Ej: 1000"
                                       styleClass="text-field"/>
                        </VBox>
                    </HBox>

                    <!-- Fila 2: Tipo dimensión | Cantidad medida -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Tipo de dimensión *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbTipoDimension"
                                      styleClass="combo-box"
                                      maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Cantidad medida *" styleClass="field-label"/>
                            <TextField fx:id="txtCantidadDimension"
                                       promptText="Ej: 20"
                                       styleClass="text-field"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ══════════════════════════════════════════════
                     TARJETA 4: PRECIO
                     ══════════════════════════════════════════════ -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Precio" styleClass="card-title"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="ℹ Origen: " styleClass="field-label"/>
                        <Label text="Identificación del Producto (nombre + cantidad + unidad)"
                               style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Precio según factura física ($) *" styleClass="field-label"/>
                        <TextField fx:id="txtPrecioFactura"
                                   promptText="Ej: 1.50"
                                   styleClass="text-field"/>
                    </VBox>
                </VBox>

                <Region prefHeight="10"/>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ============================================================
         BOTONES INFERIORES
         ============================================================ -->
    <bottom>
        <HBox styleClass="panel-footer" alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>
            <Button fx:id="btnLimpiar" text="Cancelar" styleClass="btn-secondary"
                    prefWidth="120" prefHeight="42" onAction="#handleLimpiar"/>
            <Button fx:id="btnGuardar" text="Registrar Producto" styleClass="btn-primary"
                    prefWidth="180" prefHeight="42" onAction="#handleGuardar"/>
        </HBox>
    </bottom>
</BorderPane>